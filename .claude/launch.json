{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Python HTTP Server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080"],
      "port": 8080
    },
    {
      "name": "npx http-server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["http-server", ".", "-p", "8081", "--cors", "-c-1"],
      "port": 8081
    },
    {
      "name": "npx live-server (live reload)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["live-server", "--port=8082", "--no-browser"],
      "port": 8082
    }
  ]
}
